<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyAvaloniaApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MyAvaloniaApp.Views.CatalogView"
             x:DataType="vm:CatalogViewModel">
    <Border BorderBrush="White" 
            BorderThickness="1" 
            CornerRadius="0"
            Padding="5"
            Margin="15">
        <DockPanel>
            <!--Bottom Bar-->
            <Border BorderBrush="White" 
                    BorderThickness="1" 
                    CornerRadius="0"
                    Padding="5"
                    DockPanel.Dock="Bottom">
                <StackPanel Orientation="Horizontal"
                            Spacing="5">
                    <Button Name="LogoutBtn" 
                            Content="Logout" 
                            Command="{Binding LogoutCommand}"
                            Background="Black"
                            BorderBrush="White" 
                            BorderThickness="1" 
                            CornerRadius="0"/>
                    <Button Name="BorrowedBtn" 
                            Content="Borrowed only" 
                            Command="{Binding BorrowedCommand}"
                            Background="Black"
                            BorderBrush="White" 
                            BorderThickness="1" 
                            CornerRadius="0"/>
                </StackPanel>
            </Border>
            
            <Grid ColumnDefinitions="2* *">
                <!--SideBar for showing book details-->
                <Border BorderBrush="White" 
                        BorderThickness="1" 
                        CornerRadius="0"
                        Padding="5"
                        IsVisible="{Binding ShowBookDetails}"
                        Grid.Column="1">
                    <ScrollViewer>
                        <TextBlock Text="{Binding BookDisc}"
                                    Foreground="White"
                                    TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
                <!--Space for books-->
                <Border BorderBrush="White" 
                        BorderThickness="1" 
                        CornerRadius="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="{Binding SpaceSize}">
                    <ListBox x:Name="BookList"
                            Margin="5" 
                            ItemsSource="{Binding BookList}" 
                            SelectionChanged="SelectionChanged"
                            Background="Black"/>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
