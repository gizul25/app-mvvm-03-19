<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyAvaloniaApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MyAvaloniaApp.Views.BookView"
             x:DataType="vm:BookViewModel"
             HorizontalAlignment="Stretch">
    <Border BorderBrush="DarkGray" 
            Background="Black"
            BorderThickness="1" 
            CornerRadius="0"
            Padding="5"
            HorizontalAlignment="Stretch">
        <DockPanel HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left"
                        Spacing = "5">
                <TextBlock Foreground="White"
                           Text="{Binding ShortDesc}"
                           VerticalAlignment="Center"/>
                <TextBlock Foreground="Blue"
                           Text="{Binding BorrowState}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Panel HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Name="BorrowBtn" 
                        Content="Borrow" 
                        Command="{Binding BorrowCommand}"
                        Background="Black"
                        IsVisible="{Binding BorrowVisible}" 
                        BorderBrush="White" 
                        BorderThickness="1" 
                        CornerRadius="0"/>
                <Button Name="ReturnBtn" 
                        Content="Return" 
                        Command="{Binding ReturnCommand}"
                        Background="Black"
                        IsVisible="{Binding ReturnVisible}"
                        BorderBrush="White" 
                        BorderThickness="1" 
                        CornerRadius="0"/>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
