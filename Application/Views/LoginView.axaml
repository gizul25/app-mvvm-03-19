<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:MyAvaloniaApp.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:LoginViewViewModel"
             x:Class="MyAvaloniaApp.Views.LoginView">
    <StackPanel Margin= "10">
        <TextBlock Name="StatusText" Margin="12" Text="{Binding StatusMessage}"/>
        <TextBox Name="UsernameInput" Text="{Binding Username, Mode=TwoWay}" Watermark="Username" />
        <TextBox Name="PasswordInput" Text="{Binding Password, Mode=TwoWay}" Watermark="Password" />
        <Button Name="LoginBtn" Content="Login" Command="{Binding LoginCommand}" Classes="accent" />
        <Button Name="GenerateBtn" Content="Generate" Command="{Binding GenerateCommand}" Classes="accent" />
    </StackPanel>
</UserControl>
